# Copy to .env and fill in your keys
# Only fill in the providers you use — leave the rest blank

# OpenAI (GPT Image 1/1.5/2, GPT-5.x chat, Whisper/TTS)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini, Imagen 4, Nano Banana, Veo)
GOOGLE_API_KEY=

# FAL (covers Kling, FLUX, Veo 3, Wan, LTX, Pixverse, Seedance, Luma, Sora, Ideogram, etc.)
FAL_KEY=

# Meshy
MESHY_API_KEY=

# Runway
RUNWAY_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Higgsfield supports single-key OR dual-credential auth.
# For dual credentials, use HIGGSFIELD_API_KEY=yourkey:yoursecret (sent as: Key yourkey:yoursecret)
HIGGSFIELD_API_KEY=

# QuiverAI (Arrow — text-to-SVG and image-to-SVG vectorization)
QUIVER_API_KEY=

# Krea API (Krea 2, styles, assets)
KREA_API_TOKEN=

# ---------------------------------------------------------------------------
# Nebula configuration (optional — all default to sensible locations)
# ---------------------------------------------------------------------------

# Where graph state is persisted (default: ~/.nebula)
NEBULA_STATE_DIR=

# Root directory for generated outputs (default: ./output)
NEBULA_OUTPUT_ROOT=

# Root directory for Create-view presets (default: ~/.nebula/presets)
NEBULA_PRESET_ROOT=

# Root directory for Character Studio data (default: ~/.nebula/characters)
NEBULA_CHARACTER_ROOT=
