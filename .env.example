# Optional process-level path overrides. Provider credentials do not load from
# this file: enter them in Nebula Settings or copy settings.example.json to
# settings.json. Keeping credentials out of .env avoids a second, inert setup
# path that disagrees with the application.

# ---------------------------------------------------------------------------
# Nebula configuration (optional — all default to sensible locations)
# ---------------------------------------------------------------------------

# Where graph state is persisted (default: ~/.nebula)
NEBULA_STATE_DIR=

# Root directory for generated outputs (default: ./output)
NEBULA_OUTPUT_ROOT=

# Root directory for Create-view presets (default: ~/.nebula/presets)
NEBULA_PRESET_ROOT=

# Root directory for Character Studio data (default: ~/.nebula/characters)
NEBULA_CHARACTER_ROOT=
