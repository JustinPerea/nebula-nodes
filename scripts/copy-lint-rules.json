{
  "rules": {
    "straight-quote": "Use curly quotes and apostrophes: “ ” ‘ ’, never \" or '.",
    "three-dots": "Use the ellipsis character …, not three dots.",
    "em-dash": "Rewrite without an em dash; use a period, a comma or a colon-free split.",
    "sentence-punctuation": "Rewrite the sentence without a semicolon, colon or parenthesis (units on a label, times, ratios, URLs and key-value chips are fine).",
    "title-case": "Use sentence case: only the first word and proper names start with a capital.",
    "raw-key-label": "Show a plain-words label, not a raw key (camelCase, PascalCase or snake_case).",
    "retry-button": "The action is “Try again”, not “Retry”."
  },
  "sentence": {
    "minLength": 40,
    "endings": ".?!"
