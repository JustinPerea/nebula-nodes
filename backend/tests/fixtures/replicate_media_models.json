{
  "about": "Replicate API shapes (GET /v1/models/{owner}/{name} and GET /v1/models/{owner}/{name}/versions/{id}) for made-up models, as routes/replicate_proxy.get_model_schema reads them. A file output's schema is a plain `uri` string whatever the file is; the model's `default_example.output` (its URL's extension) or a content hint in the schema says which. Used by tests/test_replicate_media_ports.py and the live check; nothing here is a real model.",
  "models": {
    "acme/clipmaker": {
      "model": {
        "owner": "acme", "name": "clipmaker", "description": "Text to video", "visibility": "public",
        "default_example": {"id": "ex-clip", "status": "succeeded", "input": {"prompt": "a fox in snow"},
                            "output": "https://replicate.delivery/xezq/abc123/output.mp4"},
        "latest_version": {"id": "v-clip"}
      },
      "version": {"id": "v-clip", "openapi_schema": {"components": {"schemas": {
        "Input": {"type": "object", "required": ["prompt"], "properties": {
          "prompt": {"type": "string", "description": "What to film"},
          "first_frame": {"type": "string", "format": "uri", "description": "Optional first frame"},
          "duration": {"type": "integer", "default": 5, "minimum": 1, "maximum": 10}}},
        "Output": {"type": "string", "format": "uri", "title": "Output"}}}}}
    },
    "acme/voicebox": {
      "model": {
        "owner": "acme", "name": "voicebox", "description": "Text to speech", "visibility": "public",
