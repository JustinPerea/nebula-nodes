    },
    {
      "name": "Krea ElevenLabs Music v2.5 runs on ElevenLabs with the key",
      "nodeId": "krea-audio-elevenlabs-music-v2-5",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "ELEVENLABS_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
