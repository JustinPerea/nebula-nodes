    {
      "name": "Krea ElevenLabs TTS on the API token runs on ElevenLabs with the key",
      "nodeId": "krea-audio-elevenlabs-tts",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "ELEVENLABS_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "elevenlabs",
        "key": "ELEVENLABS_API_KEY"
      },
