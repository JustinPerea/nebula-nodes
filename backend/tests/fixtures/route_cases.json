      "expected": {
        "kind": "fallback",
        "provider": "krea",
        "key": "KREA_API_TOKEN"
      }
    },
    {
      "name": "a cleared ElevenLabs voice_id keeps Runway TTS on Runway",
      "nodeId": "runway-tts",
