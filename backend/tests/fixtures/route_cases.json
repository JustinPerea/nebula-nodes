    {
      "name": "Krea ElevenLabs Music runs on Krea without the ElevenLabs key",
      "nodeId": "krea-audio-elevenlabs-music",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "KREA_API_TOKEN": "fixture-only",
        "ELEVENLABS_API_KEY": "  "
