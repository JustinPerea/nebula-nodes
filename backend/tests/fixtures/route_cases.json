{
  "about": "Route selection cases shared by backend/services/node_route.py select_route and frontend/src/lib/directRoute.ts selectRoute, against the real node catalog. paramKeys (when given) are the params that route shows and sends, sorted. Each case runs on its 'today' (YYYY-MM-DD), else on defaultToday, so date-gated routes (node_route.DIRECT_RETIRES) don't flip when the calendar does.",
  "defaultToday": "2026-10-14",
  "cases": [
    {
      "name": "maker key wins over the fal key",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      },
      "paramKeys": [
        "aspect_ratio",
        "enable_web_search",
        "model",
        "num_images",
        "resolution",
        "thinking_level"
      ]
    },
    {
      "name": "fal runs it without a maker key",
      "nodeId": "nano-banana-fal-edit",
      "params": {},
      "apiKeys": {
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      },
      "paramKeys": [
        "aspect_ratio",
        "enable_web_search",
        "model",
        "num_images",
        "output_format",
        "resolution",
        "seed",
        "thinking_level"
      ]
    },
    {
      "name": "a blank maker key doesn't count",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "  ",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      }
    },
    {
      "name": "nothing set names the node's provider",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {},
      "expected": {
        "kind": "unset",
        "provider": "fal",
        "key": null
      }
    },
    {
      "name": "the Krea plan wins over a maker key",
      "nodeId": "krea-image-google-nano-banana-2",
      "params": {
        "_kreaAuth": "mcp"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "plan",
        "provider": "krea",
        "key": null
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "height",
        "image_urls",
        "prompt",
        "resolution",
        "width"
      ]
    },
    {
      "name": "a Krea node on the API token takes the maker key",
      "nodeId": "krea-image-google-nano-banana-pro",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "image_urls",
        "prompt",
        "resolution"
      ]
    },
    {
      "name": "a Krea node saved before the choice takes the maker key",
      "nodeId": "krea-image-google-nano-banana",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "image_urls",
        "prompt"
      ]
    },
    {
      "name": "Krea runs it without a maker key",
      "nodeId": "krea-image-google-nano-banana-flash-lite",
      "params": {},
      "apiKeys": {
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "krea",
        "key": "KREA_API_TOKEN"
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "height",
        "image_urls",
        "prompt",
        "width"
      ]
    },
    {
      "name": "a Krea node without a maker route stays on Krea",
      "nodeId": "krea-image-openai-gpt-image-2",
      "params": {},
      "apiKeys": {
        "OPENAI_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "only",
        "provider": "krea",
        "key": "KREA_API_TOKEN"
      }
    },
    {
      "name": "an account-only Krea node bills the plan",
      "nodeId": "krea-moodboard-search",
      "params": {},
      "apiKeys": {
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "plan",
        "provider": "krea",
        "key": null
      }
    },
    {
      "name": "Vertex before the Gemini API key",
      "nodeId": "veo-3",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "GOOGLE_VERTEX_CREDENTIALS": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_VERTEX_CREDENTIALS"
      }
    },
    {
      "name": "a saved reframe without a direct resolution stays on fal",
      "nodeId": "ideogram-reframe",
      "params": {
        "image_size": "square_hd"
      },
      "apiKeys": {
        "IDEOGRAM_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      }
    },
    {
      "name": "a reframe with a direct resolution goes direct",
      "nodeId": "ideogram-reframe",
      "params": {
        "resolution": "1024x1024"
      },
      "apiKeys": {
        "IDEOGRAM_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "ideogram",
        "key": "IDEOGRAM_API_KEY"
      },
      "paramKeys": [
        "num_images",
        "rendering_speed",
        "resolution",
        "seed"
      ]
    },
    {
      "name": "Meshy on its own key",
      "nodeId": "meshy-text-to-3d",
      "params": {},
      "apiKeys": {
        "MESHY_API_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "meshy",
        "key": "MESHY_API_KEY"
      }
    },
    {
      "name": "a single-route node",
      "nodeId": "nano-banana",
      "params": {},
      "apiKeys": {
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "only",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      }
    },
    {
      "name": "a local node has no provider",
      "nodeId": "text-input",
      "params": {},
      "apiKeys": {
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "local",
        "provider": null,
        "key": null
      }
    },
    {
      "name": "Nano Banana (2.5) runs on Google the day before Google's shutdown date",
      "nodeId": "nano-banana-fal",
      "today": "2027-03-14",
      "params": {
        "model": "nano-banana"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      }
    },
    {
      "name": "Nano Banana (2.5) runs on fal from Google's shutdown date",
      "nodeId": "nano-banana-fal",
      "today": "2027-03-15",
      "params": {
        "model": "nano-banana"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      },
      "paramKeys": [
        "aspect_ratio",
        "enable_web_search",
        "model",
        "num_images",
        "output_format",
        "resolution",
        "seed",
        "thinking_level"
      ]
    },
    {
      "name": "fal's 2.5 Flash Image alias runs on fal after the shutdown too",
      "nodeId": "nano-banana-fal-edit",
      "today": "2027-04-01",
      "params": {
        "model": "gemini-25-flash-image"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      }
    },
    {
      "name": "the 2.5 shutdown leaves Nano Banana 2 on Google",
      "nodeId": "nano-banana-fal-edit",
      "today": "2027-04-01",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      }
    },
    {
      "name": "the Krea 2.5 copy runs on Krea after Google's shutdown",
      "nodeId": "krea-image-google-nano-banana",
      "today": "2027-03-15",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "krea",
        "key": "KREA_API_TOKEN"
      }
    },
    {
      "name": "the Krea 2.5 copy with only a Google key has no route after the shutdown",
      "nodeId": "krea-image-google-nano-banana",
      "today": "2027-03-15",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only"
      },
      "expected": {
        "kind": "unset",
        "provider": "krea",
        "key": null
      }
    },
    {
      "name": "an explicit width and height keep a Krea copy on Krea",
      "nodeId": "krea-image-google-nano-banana-2",
      "params": {
        "_kreaAuth": "api-token",
        "width": 1920,
        "height": 1080,
        "resolution": "2K"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "krea",
        "key": "KREA_API_TOKEN"
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "height",
        "image_urls",
        "prompt",
        "resolution",
        "width"
      ]
    },
    {
      "name": "an explicit width with only a Google key needs the Krea token",
      "nodeId": "krea-image-google-nano-banana-pro",
      "params": {
        "width": 1024
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only"
      },
      "expected": {
        "kind": "unset",
        "provider": "krea",
        "key": null
      }
    },
    {
      "name": "a cleared width doesn't block the maker route",
      "nodeId": "krea-image-google-nano-banana-2",
      "params": {
        "_kreaAuth": "api-token",
        "width": null,
        "height": ""
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      }
    },
    {
      "name": "xAI key wins over the fal key on Grok Imagine",
      "nodeId": "grok-imagine-image",
