{
  "about": "Route selection cases shared by backend/services/node_route.py select_route and frontend/src/lib/directRoute.ts selectRoute, against the real node catalog. paramKeys (when given) are the params that route shows and sends, sorted. Each case runs on its 'today' (YYYY-MM-DD), else on defaultToday, so date-gated routes (node_route.DIRECT_RETIRES) don't flip when the calendar does.",
  "defaultToday": "2026-10-14",
  "cases": [
    {
      "name": "maker key wins over the fal key",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      },
      "paramKeys": [
        "aspect_ratio",
        "enable_web_search",
        "model",
        "num_images",
        "resolution",
        "thinking_level"
      ]
    },
    {
      "name": "fal runs it without a maker key",
      "nodeId": "nano-banana-fal-edit",
      "params": {},
      "apiKeys": {
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      },
      "paramKeys": [
        "aspect_ratio",
        "enable_web_search",
        "model",
        "num_images",
        "output_format",
        "resolution",
        "seed",
        "thinking_level"
      ]
    },
    {
      "name": "a blank maker key doesn't count",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {
        "GOOGLE_API_KEY": "  ",
        "FAL_KEY": "fixture-only"
      },
      "expected": {
        "kind": "fallback",
        "provider": "fal",
        "key": "FAL_KEY"
      }
    },
    {
      "name": "nothing set names the node's provider",
      "nodeId": "nano-banana-fal",
      "params": {},
      "apiKeys": {},
      "expected": {
        "kind": "unset",
        "provider": "fal",
        "key": null
      }
    },
    {
      "name": "the Krea plan wins over a maker key",
      "nodeId": "krea-image-google-nano-banana-2",
      "params": {
        "_kreaAuth": "mcp"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "plan",
        "provider": "krea",
        "key": null
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "height",
        "image_urls",
        "prompt",
        "resolution",
        "width"
      ]
    },
    {
      "name": "a Krea node on the API token takes the maker key",
      "nodeId": "krea-image-google-nano-banana-pro",
      "params": {
        "_kreaAuth": "api-token"
      },
      "apiKeys": {
        "GOOGLE_API_KEY": "fixture-only",
        "KREA_API_TOKEN": "fixture-only"
      },
      "expected": {
        "kind": "direct",
        "provider": "google",
        "key": "GOOGLE_API_KEY"
      },
      "paramKeys": [
        "_kreaAuth",
        "aspect_ratio",
        "image_urls",
        "prompt",
        "resolution"
      ]
    },
    {
      "name": "a Krea node saved before the choice takes the maker key",
