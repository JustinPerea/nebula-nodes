{
  "_note": "PR 2's two halves joined: a person's pick in the provider switcher (frontend lib/providerSwitch.ts) to the route client that runs it (backend execution/route_clients.py). Each case runs on a fixture node in route_client_definitions.json or on a real route-table node of the registry (PR 3). `saved` is what the node holds before the click, on top of every param's default; `keys` the key names set (values are fixtures); `wired` the input ports and what each carries (one edge each). `click` is a menu row id ('auto', a route id, '<route id>:plan'), 'alternative:<route id>' for the one-click switch under a stopped run, or null for no click. `switcher` is what the switcher shows before (`before`) and after the click, and `writes` the params the click changes on the saved node (snapped values included). Python (test_route_clients.py) saves `saved` + `writes` on the node and runs it through multi_route: `run.route` is the route the router picks, and `run.request` the one provider request it makes (`body` exactly, checked against `schema`), or `run.refused` the message it stops with before any request. TS (frontend/tests/components/switchToClient.test.tsx) seeds the node in the graph store, clicks the row in the Inspector's switcher and checks the store holds `saved` + `writes`, the card note is `notes`, and the switcher shows `switcher`.",
  "cases": [
    {
      "name": "a click on fal snaps 1.5k to 2k and sends the wired image to fal's edit endpoint",
      "definition": "clients-image",
      "saved": { "resolution": "1.5k" },
      "keys": ["BFL_API_KEY", "FAL_KEY"],
      "wired": { "images": ["https://e.com/a.png"] },
      "click": "fal",
      "switcher": {
        "before": { "chip": "Auto · BFL", "blocked": false, "alternatives": [] },
        "chip": "fal", "blocked": false, "alternatives": [],
        "notes": ["1.5k isn't on fal.ai: set to 2k"]
      },
      "writes": { "_provider": "fal", "resolution": "2k" },
      "run": {
        "route": "fal",
        "request": {
          "method": "POST", "url": "https://queue.fal.run/blackforestlabs/flux-3/edit-image",
          "schema": ["fal", "blackforestlabs/flux-3/edit-image"],
          "body": { "prompt": "p", "aspect_ratio": "auto", "resolution": "2k", "safety_tolerance": 2,
                    "image_urls": ["https://e.com/a.png"] }
        }
      }
    },
    {
      "name": "no click: Auto lands on fal, which can't take 1.5k, so the run stops before any request",
      "definition": "clients-image",
      "saved": { "resolution": "1.5k" },
      "keys": ["FAL_KEY", "OPENROUTER_API_KEY"],
      "wired": {},
      "click": null,
      "switcher": {
        "before": { "chip": "Auto · fal", "blocked": true, "alternatives": ["openrouter"] },
        "chip": "Auto · fal", "blocked": true, "alternatives": ["openrouter"], "notes": []
      },
      "writes": {},
      "run": { "route": null, "refused": "can't run on fal.ai" }
    },
