    "krea-2-generate": {
      "channel": "weighted-style",
      "default": "images",
      "handler": "reads-board",
      "slots": [
        {
          "port": "image_style_references",
          "max": 10,
          "sharesLimitWith": [
            "style_images"
          ]
        }
      ],
      "never": [
        "style_images",
        "styles"
      ],
      "textSlot": {
        "port": "prompt"
      },
      "text": "brief",
      "weight": {
        "mode": "native",
        "field": "strength",
        "range": [
          0,
          1
        ],
        "normalize": "sum-to-strength",
        "precision": 0.0001,
        "schema": {
          "source": "krea-catalog",
          "endpoints": [
            "/generate/image/krea/krea-2/medium",
            "/generate/image/krea/krea-2/large"
          ],
          "field": "image_style_references"
        }
      },
      "order": "weight",
      "syntax": null,
      "syntaxReason": "The weight is native: each board image goes with its own strength (Q21 b), so the prompt names none.",
      "costPerRef": "priced",
      "sources": [
        {
          "url": "https://www.krea.ai/docs/api-reference/image/krea-2-medium.md",
          "quote": "image_style_references: Image style references. (0 = no style influence, 1 = maximum). Default 0.5. maxItems: 10; strength minimum: 0, maximum: 1",
          "checked": "2026-10-20"
        },
        {
          "url": "https://www.krea.ai/docs/developers/krea-2/style-transfer.md",
          "quote": "The references blend additively — start with strengths that sum near `1.0` and tune from there.",
          "checked": "2026-10-20"
        },
        {
          "code": "backend/data/krea_gateway_models.json",
          "quote": "/generate/image/krea/krea-2/medium and /large: image_style_references maxItems 10, items.strength minimum 0, maximum 1"
        },
        {
          "code": "backend/handlers/krea.py:406",
          "quote": "_collect_native_moodboard_style_references: remaining_slots=max(0, 10 - len(image_refs)), strengths from native_strengths"
        },
        {
          "code": "backend/data/model_pricing.json",
          "quote": "krea-2-generate priceParams include (wired moodboard)"
        }
      ],
      "checked": "2026-10-20",
      "unconfirmed": [
        "Krea's guide says \"Set `strength` between -2 and 2 per reference\" (style-transfer.md, read 2026-10-20); the schema its gateway enforces says 0 to 1, which Nebula uses"
      ]
    },
