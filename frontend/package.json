{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "npm run check:inline-styles && npm run check:slava-css-scope && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "check:slava-css-scope": "node scripts/check-slava-css-scope.mjs",
    "check:node-contracts": "node ../scripts/check-node-contracts.mjs",
    "check:utility-nodes": "node ../scripts/check-utility-nodes.mjs",
    "check:slava-screenshots": "node ../scripts/slava-screenshot-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/model-viewer": "^4.2.0",
    "@xyflow/react": "^12.10.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
